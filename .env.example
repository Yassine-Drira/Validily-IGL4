# Validily-IGL4 Environment Variables Example
# Copy this file to .env.local and populate with your Supabase project keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional base site URL for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Professional SMTP Service Configuration (validely.app@gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=validely.app@gmail.com
# Google App Password (16 characters generated from Google Account > Security > 2-Step Verification > App Passwords)
SMTP_PASSWORD=your-gmail-app-password-here
SMTP_FROM_NAME="Validily IGL4"
# Safety gate: set to true only when ready to send live emails to all students
ENABLE_EMAIL_BROADCAST=false
